# === Vertical Agent Harness (VA_*) ===
VA_MODEL=deepseek:deepseek-flash
VA_API_KEY=replace_me
VA_BASE_URL=https://api.deepseek.com
VA_ENABLED_PLUGINS='["research.citations"]'
VA_MAX_MODEL_CALLS=30
VA_ENABLE_SKILL_GATING=true
VA_ENABLE_PLANNING=true
VA_STORE_BACKEND=sqlite
# VA_STORE_DB_PATH=./.agent-workspace/store.sqlite
# VA_MEMORY_ROUTE=/memories/
VA_ENABLE_MEMORY=true
# Automatic preference learning and weekly consolidation are opt-in.
VA_ENABLE_USER_PREFERENCES=false
VA_ENABLE_MEMORY_CONSOLIDATION=false
VA_MEMORY_CONSOLIDATION_INTERVAL_DAYS=7
# Optional tool-calling model for both memory tasks; reuses VA_API_KEY / VA_BASE_URL.
# VA_MEMORY_MODEL=deepseek:deepseek-flash
# Start separately: vertical-agent --memory-worker (one worker per persistent store)

# === MCP servers (JSON object; stdio or Streamable HTTP) ===
VA_MCP_SERVERS='{}'
# VA_MCP_SERVERS='{"local":{"transport":"stdio","command":"python","args":["/absolute/path/server.py"],"env":{"API_KEY":"replace_me"}},"remote":{"transport":"streamable_http","url":"http://localhost:8000/mcp","headers":{"Authorization":"Bearer replace_me"}}}'
# Tools default to effect=external (approval required). Only trusted read-only
# servers should set "effect":"read". "timeout" defaults to 30 seconds.

# === Application Logging (stderr; independent of LangSmith) ===
VA_LOG_LEVEL=INFO
VA_LOG_FORMAT=text
# Optional UTF-8 rotating file
# VA_LOG_FILE=./.agent-workspace/logs/harness.log
# VA_LOG_MAX_BYTES=10485760
# VA_LOG_BACKUP_COUNT=5

# Optional: set both to activate per-run Dynamic Model Routing
# VA_ECONOMY_MODEL=deepseek:deepseek-flash
# VA_QUALITY_MODEL=deepseek:deepseek-v4-pro

# === LangSmith Observability ===
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=replace_me
LANGSMITH_PROJECT=vertical-research-agent
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# === Independent Evaluation / Feedback / Regression Dataset ===
# All model roles reuse VA_API_KEY / VA_BASE_URL; unset roles fall back to VA_MODEL.
# VA_EVAL_MODEL=deepseek:deepseek-flash
# VA_OPTIMIZER_MODEL=deepseek:deepseek-flash
VA_EVAL_CONCURRENCY=2
VA_ENABLE_ONLINE_EVALUATION=false
VA_ONLINE_EVAL_SAMPLE_RATE=0.1
VA_ONLINE_EVAL_POLL_SECONDS=60
VA_ONLINE_EVAL_LOOKBACK_HOURS=24
# Only explicit user corrections become regression references; ratings alone do not.
VA_ENABLE_FEEDBACK_REGRESSION=false
VA_REGRESSION_DATASET=vertical-regression
# Start separately: vertical-eval online (one worker per tracing project)
# Local offline evaluation does not upload unless --upload is supplied.

# === External Tools / Providers (Optional) ===
EXA_API_KEY=replace_me
OPENROUTER_API_KEY=replace_me
JEV_MODEL=typesafe/jev-1.13
