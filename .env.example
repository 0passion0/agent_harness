OPENAI_API_KEY=replace_me
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=replace_me
LANGSMITH_PROJECT=vertical-research-agent
VA_MODEL=openai:gpt-5.5
VA_ENABLED_PLUGINS='["research.citations"]'
VA_MAX_MODEL_CALLS=30
VA_ENABLE_SKILL_GATING=true
VA_ENABLE_PLANNING=true
# Optional; set both to activate per-run Dynamic Model Routing
# VA_ECONOMY_MODEL=openai:gpt-5.4-mini
# VA_QUALITY_MODEL=openai:gpt-5.5
