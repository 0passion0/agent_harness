# Model
VA_MODEL=deepseek:deepseek-flash
VA_API_KEY=replace_me
VA_BASE_URL=https://api.deepseek.com
# Optional web search; leave empty to run files and scripts only.
EXA_API_KEY=
VA_ENABLE_PLANNING=true
VA_STORE_BACKEND=sqlite
VA_RUN_TIMEOUT_SECONDS=900
# State databases live outside the workspace. Existing data is never moved automatically.
# VA_RUNTIME_DATA_DIR=./.agent-workspace.runtime
# VA_PYTHON_EXECUTABLE=/absolute/path/to/python
VA_LOG_LEVEL=INFO
VA_LOG_FORMAT=text
# VA_LOG_FILE=./.agent-workspace.runtime/logs/harness.log
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=agent-harness
